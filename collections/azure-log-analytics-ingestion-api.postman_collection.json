      "name": "Ingestion",
      "description": {
        "content": "Send log data to Log Analytics workspaces",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "09abc47a-0320-4801-8777-72062693cbe7",
          "name": "Azure Log Analytics Upload Logs",
          "request": {
            "name": "Azure Log Analytics Upload Logs",
            "description": {
              "content": "Send custom log data to a Log Analytics workspace via a data collection rule. The data must be a JSON array matching the stream schema defined in the DCR. Transformations defined in the DCR are applied before data reaches the target table.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataCollectionRules",
                ":dcrImmutableId",
                "streams",
                ":streamName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "2023-01-01",
                  "description": "(Required) The API version to use."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dcrImmutableId",
                  "description": "(Required) The immutable ID of the data collection rule. Found on the DCR overview page in the Azure portal."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "streamName",
                  "description": "(Required) The stream name in the DCR that should handle the data. Use Custom-TableName for custom tables."
                },
                {
                  "description": "The data collection endpoint URL",
                  "type": "any",
                  "value": "{{endpoint}}",
                  "key": "endpoint"
                }
              ]
            },
